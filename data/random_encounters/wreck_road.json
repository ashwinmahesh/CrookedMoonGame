      "once": true,
      "dialogue": "roads/act1:bone_bonfire"
    },
    {
      "id": "lost_child",
      "weight": 2,
      "when": "not flag.road_child_met",
      "once": true,
      "dialogue": "roads/act1:lost_child"
    },
    {
      "id": "wayside_shrine",
      "weight": 2,
      "when": "not flag.road_shrine_met",
      "once": true,
      "dialogue": "roads/act1:wayside_shrine"
    }
  ]
