.godot/
*.import
captures/*
!captures/.gdignore
builds/
# The default asset root when none is set (tools/asset_root.py).
.assets/
.DS_Store
art/generated/**/*.tmp

# Python bytecode from the tools.
__pycache__/

# Sprite sheets keep their import settings (mipmaps, VRAM compression) in the repo.
!art/sprites/**/walk.png.import
!art/sprites/**/attack.png.import
!art/sprites/**/hurt.png.import
!art/sprites/**/ride.png.import
!art/sprites/**/sneak.png.import
!art/sprites/**/cast.png.import
# So do the environment textures and billboard props.
!art/textures/**/*.png.import
!art/textures/**/*.webp.import
!art/sprites/props/*.png.import
# The travel map keeps its mipmaps, so it shrinks cleanly when zoomed out.
!art/ui/map/*.png.import
# Spell and item icons keep mipmaps so lists can draw them small.
!art/icons/**/*.png.import

# Textures Godot pulls out of a sourced GLB on import (regenerated by every import; the GLB holds them).
art/sourced/sketchfab_silsoe_lychgate/silsoe_lychgate_*.png
art/sourced/sketchfab_menhirs/menhirs_*.png
